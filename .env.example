# ─────────────────────────────────────────────────────────────────────────────
# SA Teacher Assistant — Environment Variables
# Copy to .env and fill in all values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Webhook verification token — any string you choose (MUST match Meta dashboard)
VERIFY_TOKEN=choose_any_secret_string_here

# App Secret from Meta Dashboard → Your App → Settings → Basic. NOT the verify token.
META_APP_SECRET=your_meta_app_secret_here

# Random secret used to sign PDF download URLs (keeps them unforgeable)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PDF_SECRET=generate_a_random_hex_string_here

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set ONE of the following:

# Option A: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenAI
# OPENAI_API_KEY=sk-...

# ── Security (POPIA compliance) ───────────────────────────────────────────────
# 32-byte random secret for HMAC-hashing phone numbers before storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_SECRET=generate_a_random_32_byte_hex_string_here

# ── Admin ───────────────────────────────────────────────────────────────────────
# Secret key for admin endpoints (e.g., granting Pro status)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=generate_a_random_hex_string_here

# ── Application ───────────────────────────────────────────────────────────────
# Public HTTPS URL of your deployment (used for PDF links and Yoco redirects)
APP_URL=https://your-app.onrender.com

PORT=3000
FREE_LIMIT=10
PRO_PRICE_ZAR=99

# ── Yoco Payments (South Africa) ──────────────────────────────────────────────
# Get from: portal.yoco.com → Developers → API Keys
# Test keys:  sk_test_... / sk_live_... for live
YOCO_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret for verifying Yoco event signatures
# Get from: portal.yoco.com → Developers → Webhooks → your endpoint secret
# Set webhook URL to: https://your-app.onrender.com/payment/webhook
YOCO_WEBHOOK_SECRET=your_yoco_webhook_secret_here

# ── Database ──────────────────────────────────────────────────────────────────
# Default: ./data/teacher_assistant.db
# On Render, mount a persistent disk and set this to the mount path
# DB_PATH=/var/data/teacher_assistant.db

# ── Error Monitoring ──────────────────────────────────────────────────────────
# Optional but strongly recommended before onboarding paying teachers.
# Get from: sentry.io → New Project → Node.js → copy DSN
# If not set, monitoring is silently disabled.
# SENTRY_DSN=https://xxx@oXXXXXXXX.ingest.sentry.io/XXXXXXXX

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256-GCM key is derived from PII_SECRET (already required above).
# No extra env var needed — the same PII_SECRET drives both HMAC phone hashing
# and AES-256-GCM phone encryption.
