# Leave blank in development — vite.config.js proxies /api to
# VITE_API_PROXY_TARGET (defaults to http://localhost:3000) so the
# dashboard and backend can run on separate ports without CORS setup.
#
# In production, point this at the deployed backend origin, e.g.:
# VITE_API_BASE_URL=https://sa-teacher-assistant.onrender.com
VITE_API_BASE_URL=
